# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dayflow-hrms?retryWrites=true&w=majority

# JWT Secrets (generate with: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log")
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me_in_production

# Server
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
